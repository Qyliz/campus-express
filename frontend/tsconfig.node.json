//Node 环境下的工具配置
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "playwright.config.*",
    "eslint.config.*"
  ],
  "compilerOptions": {
    //交给构建工具处理模块
    "module": "preserve",
    "moduleResolution": "bundler",

    //只加载 Node 类型
    "types": ["node"],

    //仅做类型检查
    "noEmit": true,

    //增量检查缓存不放在项目根目录
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
