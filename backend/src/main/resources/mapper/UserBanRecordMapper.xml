<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--suppress XmlUnresolvedReference -->
<mapper namespace="cn.njust.campusexpress.model.user.mapper.UserBanRecordMapper">

    <!-- 分页查询封禁记录列表：被封禁账户的角色已作为 user_ban_record.role 列存下，
         故只需联 user 主表取用户名、性别、手机号、邮箱。
         注意：deleted 过滤只能判断 u.deleted，角色账户行已注销不再隐藏其历史封禁记录（封禁记录本就用于留痕）。 -->
    <select id="selectBanPage" resultType="cn.njust.campusexpress.model.user.vo.UserBanRecordVO">
        SELECT b.id AS userBanRecordId,
        b.user_id AS userId,
        b.role,
        u.username,
        u.gender,
        u.phone,
        u.email,
        b.unbanned,
        b.reason,
        b.create_time AS createTime
        FROM user_ban_record b
        INNER JOIN user u ON b.user_id = u.id
        <where>
            <!-- deleted 为空则不过滤（完整留痕）；true 仅已注销；false 仅活跃 -->
            <if test="dto.deleted != null">
                <choose>
                    <when test="dto.deleted">
                        AND u.deleted != 0
                    </when>
                    <otherwise>
                        AND u.deleted = 0
                    </otherwise>
                </choose>
            </if>
            <if test="dto.username != null and dto.username != ''">
                AND u.username LIKE CONCAT('%', #{dto.username}, '%')
            </if>
            <if test="dto.phone != null and dto.phone != ''">
                AND u.phone LIKE CONCAT(#{dto.phone}, '%')
            </if>
            <if test="dto.email != null and dto.email != ''">
                AND u.email LIKE CONCAT(#{dto.email}, '%')
            </if>
            <!-- unbanned：null=全部，true=仅已解封，false=仅封禁中 -->
            <if test="dto.unbanned != null">
                <choose>
                    <when test="dto.unbanned">AND b.unbanned = 1</when>
                    <otherwise>AND b.unbanned = 0</otherwise>
                </choose>
            </if>
        </where>
        <choose>
            <when test="dto.sort != null and dto.sort.name() == 'CREATE_TIME_ASC'">
                ORDER BY b.create_time ASC, b.id ASC
            </when>
            <!-- user_ban_record 无 update_time，其余排序一律按创建时间倒序，并以唯一主键 b.id 兜底，保证分页顺序稳定 -->
            <otherwise>
                ORDER BY b.create_time DESC, b.id DESC
            </otherwise>
        </choose>
    </select>
</mapper>
