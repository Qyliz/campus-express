<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--suppress XmlUnresolvedReference -->
<mapper namespace="cn.njust.campusexpress.model.user.mapper.UserAuditRecordMapper">

    <resultMap id="BaseResultMap" type="cn.njust.campusexpress.model.user.entity.UserAuditRecord">
        <id property="id" column="id"/>
        <result property="userRoleId" column="user_role_id"/>
        <result property="status" column="status"/>
        <result property="reason" column="reason"/>
        <result property="material" column="material"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,user_role_id,status,reason,material,create_time,update_time
    </sql>

    <!-- 分页查询审核记录列表：user_audit_record 关联 user_role 与 user，动态拼接查询条件与排序 -->
    <select id="selectAuditPage" resultType="cn.njust.campusexpress.model.user.vo.UserAuditRecordVO">
        SELECT r.id AS userAuditRecordId,
        ur.username,
        ur.gender,
        u.phone,
        u.email,
        r.status,
        r.reason,
        r.material,
        r.create_time AS createTime,
        r.update_time AS updateTime
        FROM user_audit_record r
        INNER JOIN user_role ur ON r.user_role_id = ur.id
        INNER JOIN user u ON ur.user_id = u.id
        <where>
            <!-- deleted 为空则不过滤（完整留痕）；true 仅已注销；false 仅活跃 -->
            <if test="dto.deleted != null">
                <choose>
                    <when test="dto.deleted">
                        AND (u.deleted != 0 OR ur.deleted != 0)
                    </when>
                    <otherwise>
                        AND u.deleted = 0 AND ur.deleted = 0
                    </otherwise>
                </choose>
            </if>
            <if test="dto.username != null and dto.username != ''">
                AND ur.username LIKE CONCAT('%', #{dto.username}, '%')
            </if>
            <if test="dto.phone != null and dto.phone != ''">
                AND u.phone LIKE CONCAT(#{dto.phone}, '%')
            </if>
            <if test="dto.email != null and dto.email != ''">
                AND u.email LIKE CONCAT(#{dto.email}, '%')
            </if>
            <if test="dto.auditStatus != null">
                AND r.status = #{dto.auditStatus}
            </if>
        </where>
        <choose>
            <when test="dto.sort != null and dto.sort.name() == 'CREATE_TIME_ASC'">
                ORDER BY r.create_time ASC, r.id ASC
            </when>
            <when test="dto.sort != null and dto.sort.name() == 'CREATE_TIME_DESC'">
                ORDER BY r.create_time DESC, r.id DESC
            </when>
            <when test="dto.sort != null and dto.sort.name() == 'UPDATE_TIME_ASC'">
                ORDER BY r.update_time ASC, r.id ASC
            </when>
            <when test="dto.sort != null and dto.sort.name() == 'UPDATE_TIME_DESC'">
                ORDER BY r.update_time DESC, r.id DESC
            </when>
            <!-- sort 为空时，默认按创建时间倒序，并以唯一主键 r.id 兜底，保证分页顺序稳定 -->
            <otherwise>
                ORDER BY r.create_time DESC, r.id DESC
            </otherwise>
        </choose>
    </select>
</mapper>
